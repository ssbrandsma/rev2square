# Rev2Square isolated Ghidra headless runner (Linux ARM64).
#
# Pinned:
#   Ghidra 12.2, ghidra_12.2_PUBLIC_20261016.zip
#     sha256:2c2cd776db3c1f6a097ba418922378ac3649cadd5e844a6f5f088ae628a7be67
#     source: https://github.com/NationalSecurityAgency/ghidra/releases/tag/Ghidra_12.2_build
#     license: Apache-2.0
#   Eclipse Temurin JDK 25.0.5+8 (aarch64, hotspot, LTS)
#     sha256:bb5b2ded252f21c6090cf780b0a408ad0d83bbb557e702955643557f13231880
#     source: https://api.adoptium.net (temurin25-binaries jdk-25.0.5+8)
#     license: GPL-2.0-with-Classpath-exception
#
# The public release ships Linux natives for x86-64 only, so this
# build compiles the native components for linux_arm_64 (decompile,
# sleigh, two GNU demanglers, lzfse) from the distribution via the
# documented `./gradlew buildNatives` step (needs build-time
# internet for the Gradle distribution + native build inputs).
# buildNatives links into <module>/build/os/linux_arm_64/ and does
# NOT install: this Dockerfile copies the five verified outputs
# into the os/linux_arm_64/ directories Ghidra actually loads from.
# 12.2 no longer bundles the amd64-only 7-Zip-JBinding, so no
# amd64-only library remains on the headless path.
# Debugger/symbolic-execution extras are not enabled: headless
# import + analysis + decompile only.
#
# Build (owner, on the ARM64 server; allow 20-40 min for buildNatives):
#   docker build -f docker/analysis/Dockerfile.ghidra \
#     -t rev2square/ghidra:12.2 docker/analysis
ARG DEBIAN_IMAGE=debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
ARG GHIDRA_VERSION=12.2
ARG GHIDRA_ZIP=ghidra_12.2_PUBLIC_20261016.zip
ARG GHIDRA_SHA256=2c2cd776db3c1f6a097ba418922378ac3649cadd5e844a6f5f088ae628a7be67
ARG TEMURIN_JDK_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.5%2B8/OpenJDK25U-jdk_aarch64_linux_hotspot_25.0.5_8.tar.gz
ARG TEMURIN_JDK_SHA256=bb5b2ded252f21c6090cf780b0a408ad0d83bbb557e702955643557f13231880

# ---- JDK stage ------------------------------------------------------
FROM ${DEBIAN_IMAGE} AS jdk

ARG TEMURIN_JDK_URL
ARG TEMURIN_JDK_SHA256

# Preflight: fail fast with a clear message on missing/empty build
# inputs instead of an opaque curl error after expensive steps.
RUN : "${TEMURIN_JDK_URL:?missing build input TEMURIN_JDK_URL}" \
    && : "${TEMURIN_JDK_SHA256:?missing build input TEMURIN_JDK_SHA256}" \
    && case "${TEMURIN_JDK_URL}" in https://*) ;; *) echo "TEMURIN_JDK_URL must be an https URL" >&2; exit 1;; esac

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/jdk \
    && curl -fsSL -o /tmp/jdk.tar.gz "${TEMURIN_JDK_URL}" \
    && echo "${TEMURIN_JDK_SHA256}  /tmp/jdk.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/jdk.tar.gz -C /opt/jdk --strip-components=1 \
    && rm /tmp/jdk.tar.gz \
    && /opt/jdk/bin/java -version

# ---- Native-build stage ---------------------------------------------
FROM ${DEBIAN_IMAGE} AS natives

ARG GHIDRA_VERSION
ARG GHIDRA_ZIP
ARG GHIDRA_SHA256

COPY --from=jdk /opt/jdk /opt/jdk
ENV JAVA_HOME=/opt/jdk \
    PATH=/opt/jdk/bin:${PATH}

# Preflight before the 20-40 minute buildNatives: fail fast with a
# clear message on missing/empty build inputs. (The download URL
# host is hardcoded https; only the versioned parts vary.)
RUN : "${GHIDRA_VERSION:?missing build input GHIDRA_VERSION}" \
    && : "${GHIDRA_ZIP:?missing build input GHIDRA_ZIP}" \
    && : "${GHIDRA_SHA256:?missing build input GHIDRA_SHA256}"

# g++ is required: decompile/sleigh are C++ (the demanglers and
# lzfse are C). `make` stays as cheap insurance; bison/flex are NOT
# needed (the build scripts assume up-to-date generated parsers).
RUN echo "--- natives: install build toolchain ---" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl file g++ gcc make python3 unzip zip \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/dist

# Toolchain gate BEFORE the expensive download + buildNatives: prove
# both compilers exist now instead of failing 20 minutes into Gradle
# with `Could not find C++ compiler 'g++' in system path`.
RUN echo "--- natives: C and C++ compilers available ---" \
    && gcc --version \
    && g++ --version

RUN echo "--- natives: fetch pinned Ghidra distribution ---" \
    && curl -fsSL -o /tmp/ghidra.zip \
        "https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GHIDRA_VERSION}_build/${GHIDRA_ZIP}" \
    && echo "${GHIDRA_SHA256}  /tmp/ghidra.zip" | sha256sum -c - \
    && unzip -q /tmp/ghidra.zip -d /opt/dist \
    && rm /tmp/ghidra.zip \
    && mv /opt/dist/ghidra_${GHIDRA_VERSION}_PUBLIC /opt/ghidra \
    && test -x /opt/ghidra/support/gradle/gradlew

RUN echo "--- natives: buildNatives for linux_arm_64 (20-40 min) ---" \
    && cd /opt/ghidra/support/gradle \
    && ./gradlew --no-daemon buildNatives

# Native-output discovery is deterministic, from
# GPL/nativeBuildProperties.gradle: buildNatives links into
# <module>/build/os/<platform>/ and does NOT install into
# os/<platform>/ — that copy is done here, explicitly, for exactly
# the five linux_arm_64 executables the distribution builds
# (decompile, sleigh, two demanglers, lzfse). No find|head
# guessing, no invented platform names: the Gradle log's
# `linux_arm_64` is the os/ directory name by construction.
RUN echo "--- natives: verify + install linux_arm_64 outputs ---" \
    && cd /opt/ghidra \
    && for f in \
        Ghidra/Features/Decompiler/build/os/linux_arm_64/decompile \
        Ghidra/Features/Decompiler/build/os/linux_arm_64/sleigh \
        GPL/DemanglerGnu/build/os/linux_arm_64/demangler_gnu_v2_41 \
        GPL/DemanglerGnu/build/os/linux_arm_64/demangler_gnu_v2_24 \
        Ghidra/Features/FileFormats/build/os/linux_arm_64/lzfse \
    ; do \
        test -x "$f" || { echo "MISSING NATIVE OUTPUT: $f" >&2; exit 1; }; \
        file "$f" | grep -qi 'ARM aarch64' || { echo "NOT AARCH64: $f" >&2; exit 1; }; \
    done \
    && test "$(ls Ghidra/Features/Decompiler/build/os/linux_arm_64/ | wc -l)" -eq 2 \
    && test "$(ls GPL/DemanglerGnu/build/os/linux_arm_64/ | wc -l)" -eq 2 \
    && test "$(ls Ghidra/Features/FileFormats/build/os/linux_arm_64/ | wc -l)" -eq 1 \
    && mkdir -p Ghidra/Features/Decompiler/os/linux_arm_64 GPL/DemanglerGnu/os/linux_arm_64 Ghidra/Features/FileFormats/os/linux_arm_64 \
    && cp Ghidra/Features/Decompiler/build/os/linux_arm_64/decompile Ghidra/Features/Decompiler/build/os/linux_arm_64/sleigh Ghidra/Features/Decompiler/os/linux_arm_64/ \
    && cp GPL/DemanglerGnu/build/os/linux_arm_64/demangler_gnu_v2_41 GPL/DemanglerGnu/build/os/linux_arm_64/demangler_gnu_v2_24 GPL/DemanglerGnu/os/linux_arm_64/ \
    && cp Ghidra/Features/FileFormats/build/os/linux_arm_64/lzfse Ghidra/Features/FileFormats/os/linux_arm_64/ \
    && chmod 755 Ghidra/Features/Decompiler/os/linux_arm_64/* GPL/DemanglerGnu/os/linux_arm_64/* Ghidra/Features/FileFormats/os/linux_arm_64/* \
    && if cmp -s Ghidra/Features/Decompiler/os/linux_arm_64/decompile Ghidra/Features/Decompiler/os/linux_x86_64/decompile; then echo "ARM64 decompile identical to bundled x86_64 copy - install mix-up" >&2; exit 1; fi \
    && sha256sum \
        Ghidra/Features/Decompiler/os/linux_arm_64/decompile \
        Ghidra/Features/Decompiler/os/linux_arm_64/sleigh \
        GPL/DemanglerGnu/os/linux_arm_64/demangler_gnu_v2_41 \
        GPL/DemanglerGnu/os/linux_arm_64/demangler_gnu_v2_24 \
        Ghidra/Features/FileFormats/os/linux_arm_64/lzfse \
        | sed 's|Ghidra/Features|/opt/ghidra/Ghidra/Features|; s|GPL/|/opt/ghidra/GPL/|' > /provenance-arm64-natives.sha256 \
    && cat /provenance-arm64-natives.sha256

# ---- Runtime stage --------------------------------------------------
FROM ${DEBIAN_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    JAVA_HOME=/opt/jdk \
    PATH=/opt/jdk/bin:${PATH} \
    HOME=/home/www-data \
    GHIDRA_HEADLESS=/opt/ghidra/support/analyzeHeadless \
    TOOL_IMAGE=rev2square/ghidra:12.2

LABEL org.rev2square.tool="ghidra" \
      org.rev2square.tool-version="12.2" \
      org.rev2square.tool-source="https://github.com/NationalSecurityAgency/ghidra/releases/tag/Ghidra_12.2_build" \
      org.rev2square.tool-sha256="2c2cd776db3c1f6a097ba418922378ac3649cadd5e844a6f5f088ae628a7be67" \
      org.rev2square.tool-license="Apache-2.0" \
      org.rev2square.jdk="temurin-25.0.5+8-aarch64" \
      org.rev2square.jdk-sha256="bb5b2ded252f21c6090cf780b0a408ad0d83bbb557e702955643557f13231880" \
      org.rev2square.base-image="debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3"

# Full python3 (NOT python3-minimal): the runner needs stdlib
# modules such as json that the minimal package omits.
# libstdc++6: the g++-built decompile/sleigh binaries need it at
# runtime (the ldd gate below proves no shared library is missing).
# ca-certificates: Ghidra logs an ERROR when no OS CA bundle is
# readable; the bundle keeps the trust store complete and the logs
# clean. It enables no network use (there is none) and changes no
# verification behavior (the Java default store stays as fallback).
# No compilers in this stage: builder-only toolchain stays behind.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 libstdc++6 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/runner /opt/smoke /provenance

COPY --from=jdk /opt/jdk /opt/jdk
COPY --from=natives /opt/ghidra /opt/ghidra
COPY --from=natives /provenance-arm64-natives.sha256 /provenance/arm64-natives.sha256
# COPY preserves host file modes: a checkout created under umask 077
# yields mode 600, unreadable by www-data (this exact failure blocked
# the ARM64 build at the post-script). Every repo-file COPY below
# declares its mode explicitly; the install step re-asserts modes
# after cp so neither host umask nor cp semantics can regress them.
COPY --chmod=755 runner.py /opt/runner/runner.py
COPY --chmod=644 ExportEvidence.java /opt/ghidra/ExportEvidence.java
COPY --chmod=644 fixtures/arm32-smoke.bin /opt/smoke/arm32-smoke.bin

# Reviewed evidence-export script, installed where analyzeHeadless
# resolves -postScript names (plus the read-only reviewed copy above).
# The installed ARM64 natives must hash-match the builder outputs:
# this proves COPY carried the verified files, not stale layers.
RUN cp /opt/ghidra/ExportEvidence.java \
        /opt/ghidra/Ghidra/Features/Base/ghidra_scripts/ExportEvidence.java \
    && chmod 755 /opt/ghidra/Ghidra/Features/Base/ghidra_scripts \
    && chmod 644 /opt/ghidra/Ghidra/Features/Base/ghidra_scripts/ExportEvidence.java \
    && chmod 644 /opt/ghidra/ExportEvidence.java \
    && /opt/jdk/bin/java -version > /provenance/java-version.txt 2>&1 \
    && find /opt/ghidra -name decompile -type f > /provenance/decompile-bins.txt \
    && sha256sum -c /provenance/arm64-natives.sha256 \
    && chmod 644 /provenance/* /opt/smoke/arm32-smoke.bin \
    && chmod 755 /opt/runner/runner.py

# Writable home for the non-root runtime user. Java derives
# user.home from /etc/passwd, NOT from $HOME (verified: with
# HOME=/tmp exported, user.home still resolved to /var/www and
# Ghidra's LaunchSupport -save died with FileNotFoundException,
# cascading into the no-TTY JDK prompt). Pointing the passwd entry
# at /home/www-data fixes both errors at the root. That path is a
# www-data-owned layer dir at build time and uid/gid-pinned tmpfs
# at runtime (see compose), so both contexts agree. The sed is
# anchored on the exact current entry: if the base image ever
# changes www-data's ids, the match fails and the pwd assertion
# below fails the build loudly instead of mis-editing passwd.
RUN echo "--- install: home for www-data ---" \
    && sed -i 's|^www-data:x:33:33:www-data:/var/www:|www-data:x:33:33:www-data:/home/www-data:|' /etc/passwd \
    && python3 -c "import pwd; assert pwd.getpwnam('www-data').pw_dir=='/home/www-data'" \
    && mkdir -p /home/www-data \
    && chown www-data:www-data /home/www-data \
    && chmod 755 /home/www-data

# Non-interactive JDK selection via the launcher's documented
# mechanism: with JAVA_HOME_OVERRIDE set, LaunchSupport uses
# /opt/jdk without discovery heuristics or prompting.
RUN echo "--- install: pin JDK via JAVA_HOME_OVERRIDE ---" \
    && sed -i 's|^JAVA_HOME_OVERRIDE=$|JAVA_HOME_OVERRIDE=/opt/jdk|' /opt/ghidra/support/launch.properties \
    && grep -q '^JAVA_HOME_OVERRIDE=/opt/jdk$' /opt/ghidra/support/launch.properties

# Spool/results mount points (named volumes shared with the coordinator).
# Pre-created www-data-owned so volume initialization preserves uid 33:
# the runner reads the spool (mounted :ro) and writes results as
# www-data. Never 777: these carry untrusted job traffic.
RUN mkdir -p /spool /results && chown www-data:www-data /spool /results

USER www-data

# Runtime self-checks execute as the non-root runtime user. Each gate
# is its own labeled layer so the build log names the exact failing
# check. They run with the image's real home configuration (no
# HOME=/tmp masking): passwd, $HOME, and Java user.home must agree.
# Readability comes first: a restrictive host umask must never again
# surface as a confusing failure deep inside a Ghidra launch.
RUN echo "--- smoke: runtime inputs readable as www-data ---" \
    && test -r /opt/ghidra/Ghidra/Features/Base/ghidra_scripts/ExportEvidence.java \
    && test -r /opt/ghidra/ExportEvidence.java \
    && test -r /opt/runner/runner.py \
    && test -r /opt/smoke/arm32-smoke.bin \
    && test -r /etc/ssl/certs/ca-certificates.crt \
    && test -x /opt/ghidra/support/analyzeHeadless

RUN echo "--- smoke: python stdlib imports (www-data) ---" \
    && python3 -c "import argparse, fcntl, hashlib, json, os, platform, re, select, shutil, signal, subprocess, sys, time"

RUN echo "--- smoke: JDK executes (www-data) ---" \
    && /opt/jdk/bin/java -version

# Home-alignment gate: the exact mechanism that failed on the
# server. $HOME (image ENV) and Java user.home (passwd-derived)
# must both resolve to the writable home.
RUN echo "--- smoke: home aligned for www-data ---" \
    && test "$HOME" = /home/www-data \
    && test -d /home/www-data -a -w /home/www-data \
    && /opt/jdk/bin/java -XshowSettings:properties -version 2>&1 | grep -qE '^\s+user\.home = /home/www-data$'

# Architecture gate without the `file` package: read the ELF header
# directly (e_machine == 183 is EM_AARCH64). Validated both ways:
# accepts ARM64, rejects x86-64 (e_machine 62).
RUN echo "--- smoke: decompile is AArch64 ELF (www-data) ---" \
    && python3 -c "import struct,sys; m=struct.unpack('<H', open('/opt/ghidra/Ghidra/Features/Decompiler/os/linux_arm_64/decompile','rb').read()[18:20])[0]; sys.exit(0 if m==183 else 'decompile is not AArch64 ELF')"

# Shared-library gate: every NEEDED entry of the freshly built
# decompile binary must resolve (this is what mandates libstdc++6
# above — if another library ever goes missing, this fails loudly
# instead of crashing the first headless run).
RUN echo "--- smoke: native runtime deps resolve (www-data) ---" \
    && ldd /opt/ghidra/Ghidra/Features/Decompiler/os/linux_arm_64/decompile > /tmp/decompile-ldd.txt \
    && if grep -q 'not found' /tmp/decompile-ldd.txt; then echo "MISSING SHARED LIBS:" >&2; cat /tmp/decompile-ldd.txt >&2; exit 1; fi \
    && grep -q 'libstdc++' /tmp/decompile-ldd.txt

# Headless execution gate: import-only run as www-data (JVM +
# launcher + loader path, no post-script), with the exact per-job
# environment the runner uses (runner.tool_env: no HOME, JVM paths
# scoped to the job dir). analyzeHeadless takes TWO positionals
# (project location + name) and requires the location to exist.
RUN echo "--- smoke: headless import executes as www-data ---" \
    && mkdir -p /tmp/gimp && cp /opt/smoke/arm32-smoke.bin /tmp/gimp/input.bin \
    && python3 -c "import os,subprocess,sys; sys.path.insert(0,'/opt/runner'); import runner; os.makedirs('/tmp/gimp/proj',exist_ok=True); subprocess.run(['/opt/ghidra/support/analyzeHeadless','/tmp/gimp/proj','analysis','-import','/tmp/gimp/input.bin','-overwrite','-processor','ARM:LE:32:v8','-cspec','default','-deleteProject'],check=True,timeout=600,env=runner.tool_env('ghidra','/tmp/gimp'))" \
    && rm -rf /tmp/gimp

# Integration gate: run the REAL runner argv (built by
# runner.build_argv, not a hand-written copy) over the known
# 20-byte ARM32 fixture and assert known evidence: schema, the
# memory map genuinely rebased to 0x8000, the script-created entry
# function at 0x8000, the exact MOV bytes AT 0x8000 (address and
# bytes together — the loader passes no explicit base option, so
# the rebase must be proven, not assumed), and decompiled C
# containing a return.
RUN echo "--- smoke: fixture decompiles via runner argv (www-data) ---" \
    && mkdir -p /tmp/gsmoke && cp /opt/smoke/arm32-smoke.bin /tmp/gsmoke/input.bin \
    && python3 -c "import json,subprocess,sys; sys.path.insert(0,'/opt/runner'); import runner; argv=runner.build_argv('ghidra','headless',{'language':'ARM:LE:32:v8','base':0x8000,'entry':0x8000},'/tmp/gsmoke','/tmp/gsmoke/input.bin'); print(json.dumps(argv)); subprocess.run(argv,check=True,timeout=600,env=runner.tool_env('ghidra','/tmp/gsmoke'))" \
    && python3 -c "import json; e=json.load(open('/tmp/gsmoke/evidence.json')); assert e['schema']==1,'schema'; assert e['tool']=='ghidra','tool'; assert e['language']=='ARM:LE:32:v8','language'; assert any(m.get('start')=='0x8000' and m.get('size')==20 and m.get('execute')==True for m in e['memory']),'memory map'; assert any(f.get('name')=='entry' and f.get('entry')=='0x8000' for f in e['functions']),'entry fn'; assert any(l.get('address')=='0x8000' and l.get('bytes')=='0100a0e3' for l in e['disassembly']['lines']),'mov at 0x8000'; assert any('r0' in l.get('text','').lower() for l in e['disassembly']['lines']),'r0 text'; d={f.get('entry'):f for f in e['decompilation']['functions']}; assert 'c' in d.get('0x8000',{}),'decompiled c'; assert 'return' in d['0x8000']['c'].lower(),'return in c'; print('FIXTURE EVIDENCE OK')" \
    && rm -rf /tmp/gsmoke

# Scoping gate: after two headless runs, no job files may leak
# into the shared home or the default cache location (both runs
# scoped user.home, java.io.tmpdir, and application.cachedir to
# their job dirs, which are now deleted).
RUN echo "--- smoke: job files stayed scoped (www-data) ---" \
    && test ! -e /home/www-data/.ghidra || { echo "LEAK: job files in shared home" >&2; exit 1; } \
    && test ! -e /var/tmp/www-data-ghidra || { echo "LEAK: cache escaped to /var/tmp" >&2; exit 1; }

RUN echo "--- smoke: runner dry-run argv (www-data) ---" \
    && mkdir -p /tmp/dry \
    && python3 /opt/runner/runner.py --dry-run --tool ghidra \
        --profile headless \
        --params-json '{"language":"ARM:LE:32:v8","base":134217728}' \
        --workdir /tmp/dry | grep -q 'ExportEvidence.java'

CMD ["python3", "/opt/runner/runner.py", "--tool", "ghidra", \
     "--spool", "/spool", "--results", "/results"]
