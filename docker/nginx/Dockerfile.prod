# Rev2Square production Nginx image (WP5B).
#
# Serves the compiled frontend assets baked in at build time (same
# package-lock.json as the app image, built independently so nginx needs no
# shared volume with php-fpm). No source bind mounts at runtime.

FROM node:22 AS assets

WORKDIR /src

COPY package.json package-lock.json ./

RUN npm ci --ignore-scripts --no-audit --no-fund

COPY resources resources
COPY vite.config.js ./
COPY public public

RUN npm run build

FROM nginx:1.28

# curl serves the container healthcheck (the base image ships no HTTP client).
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY docker/nginx/default.prod.conf /etc/nginx/conf.d/default.conf
COPY public /var/www/public
COPY --from=assets /src/public/build /var/www/public/build

# COPY preserves host mode bits, so a restrictive checkout umask (e.g. 077
# in the deploy script) would otherwise bake root-owned 600/700 paths into
# the image that the unprivileged nginx worker cannot read or traverse
# (try_files then falls through to Laravel, which answers 404). Normalize
# deterministically AFTER every COPY into the document root so any
# cache-enabled build is servable regardless of host permissions. Plain
# find (no -L/-follow): symlinks are neither followed nor altered, so
# nothing outside the document root is reachable through them.
RUN find /var/www/public -type d -exec chmod 755 {} + \
    && find /var/www/public -type f -exec chmod 644 {} +
