# Rev2Square production environment template (WP5B).
#
# On the server: copy to .env.production, fill every CHANGE-ME value, then
#   chmod 600 .env.production
# Never commit .env.production (it is git-ignored). Generate secrets with:
#   openssl rand -base64 32
#
# Every compose.prod.yaml command needs this file twice: once for Compose
# variable interpolation (--env-file) and once inside the containers
# (env_file). The DEPLOYMENT.md commands always pass
#   --env-file .env.production

APP_NAME=Rev2Square
APP_ENV=production
# Generate AFTER first build, then paste here (see docs/DEPLOYMENT.md):
#   docker compose -f compose.prod.yaml run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://rev2square.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB (Compose network only, no published port). The app connects as
# DB_USERNAME; DB_ROOT_PASSWORD is for backups/admin via the db container.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=rev2square
DB_USERNAME=rev2square
DB_PASSWORD=CHANGE-ME-32-BYTES
DB_ROOT_PASSWORD=CHANGE-ME-32-BYTES

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Trust the Caddy proxy's forwarded headers ("*" is safe here because only
# the proxy publishes ports). To pin it down, list proxy IPs/CIDRs instead.
TRUSTED_PROXIES=*

# TLS front proxy. Caddy obtains + renews ACME certificates automatically
# once DNS points here. For a local smoke test use DOMAIN=localhost with
# custom HTTP_PORT/HTTPS_PORT (see docs/DEPLOYMENT.md).
DOMAIN=rev2square.example.com

# Deployment variant (virtualmin|prod). Admin diagnostics and backend
# notes use it to render the exact owner commands for this deployment
# (compose file + env file). Keep in sync with the compose file in use.
# NOTE: compose.prod.yaml ships no analysis runners or coordinator, so
# its backend notes point at provisioning docs instead of commands.
DEPLOY_VARIANT=prod
# HTTP_PORT=80
# HTTPS_PORT=443

# Image tag suffix (rollback support). Leave commented for :latest, or set
# to the deployed git SHA, e.g. APP_VERSION=6037afb.
# APP_VERSION=

AI_PROVIDER=meta
# Never commit a real key. Paste the server-side key here only.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Optional: raise the GitHub import rate limit (60/hr anonymous).
GITHUB_TOKEN=
# Import budgets (defaults shown). Inventory (what exists) is tracked
# separately from evidence (what enters AI context).
# GITHUB_MAX_FILES=50
# GITHUB_MAX_EVIDENCE_BYTES=500000
# GITHUB_MAX_EXTRACTION_BYTES=100000
# GITHUB_MAX_CHUNK_BYTES=20000
# GITHUB_MAX_DOWNLOAD_BYTES=2000000
# GITHUB_MAX_DOWNLOAD_FILE_BYTES=1000000
# GITHUB_MAX_INVENTORY=5000
# GITHUB_TOKEN_BUDGET=100000
# Analysis evidence budget (chars/4) per AI run.
# AI_ANALYSIS_TOKEN_BUDGET=60000
