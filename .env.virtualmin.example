# Rev2Square Virtualmin/ARM64 environment template (WP5B adaptation).
#
# On the server: copy to .env.virtualmin, fill every CHANGE-ME value, then
#   chmod 600 .env.virtualmin
# Never commit .env.virtualmin (it is git-ignored). Generate secrets with:
#   openssl rand -base64 32
#
# Every compose.virtualmin.yaml command needs this file twice: once for
# Compose variable interpolation (--env-file) and once inside the
# containers (env_file). The DEPLOYMENT_VIRTUALMIN_ARM64.md commands always
# pass --env-file .env.virtualmin. The backup/restore/status scripts accept
# --variant virtualmin as a shortcut for both.

APP_NAME=Rev2Square
APP_ENV=production
# Generate AFTER first build, then paste here (see docs/DEPLOYMENT_VIRTUALMIN_ARM64.md):
#   docker compose -f compose.virtualmin.yaml --env-file .env.virtualmin run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Public HTTPS URL served by Virtualmin Apache (no trailing slash).
APP_URL=https://rev2square.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Container MariaDB (Compose network only, no published port; fully
# isolated from Virtualmin's host MariaDB). The app connects as
# DB_USERNAME; DB_ROOT_PASSWORD is for backups/admin via the db container.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=rev2square
DB_USERNAME=rev2square
DB_PASSWORD=CHANGE-ME-32-BYTES
DB_ROOT_PASSWORD=CHANGE-ME-32-BYTES

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Two proxy layers: Apache (TLS) -> nginx (loopback) -> php-fpm. Laravel's
# direct peer is always the in-Compose nginx, so forwarded headers are
# trusted from private networks only. Keep this unless Docker is
# configured with a non-private subnet (then pin TRUSTED_PROXIES to it).
TRUSTED_PROXIES=PRIVATE_SUBNETS

# Host-header allowlist (comma-separated plain hostnames; loopback entries
# for container healthchecks are always added automatically). Empty means:
# the APP_URL host plus loopback. Pin explicitly if the app must answer to
# additional names (e.g. a staging alias).
# TRUSTED_HOSTS=rev2square.example.com

# Loopback entry point for Apache's ProxyPass. nginx listens on
# 127.0.0.1:APP_LOOPBACK_PORT on the host; change the port only if 8081
# collides with another Virtualmin site (and mirror it in Apache).
APP_LOOPBACK_PORT=8081

# Explicit image target platform. Default linux/arm64 matches the Hetzner
# ARM64 VPS. For local behavior validation on amd64 hardware, override to
# linux/amd64 (this validates wiring, NOT arm64 execution).
DOCKER_PLATFORM=linux/arm64

# Image tag suffix (rollback support). Leave commented for :latest, or set
# to the deployed git SHA, e.g. APP_VERSION=6037afb.
# APP_VERSION=

AI_PROVIDER=meta
# Never commit a real key. Paste the server-side key here only.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Optional: raise the GitHub import rate limit (60/hr anonymous).
GITHUB_TOKEN=
