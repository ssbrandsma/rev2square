# Rev2Square Virtualmin/ARM64 environment template (WP5B adaptation).
#
# On the server: copy to /etc/rev2square/.env.virtualmin, fill every
# CHANGE-ME value, then
#   chmod 600 /etc/rev2square/.env.virtualmin
# Never commit the live file. Generate secrets with:
#   openssl rand -base64 32
#
# Every compose.virtualmin.yaml command needs this file twice, through two
# distinct mechanisms: once for Compose variable interpolation (the
# --env-file CLI flag) and once inside the containers (the services'
# env_file entries, which point at the same absolute /etc path).
# DEPLOYMENT_VIRTUALMIN_ARM64.md commands always pass
# --env-file /etc/rev2square/.env.virtualmin. The backup/restore/status
# scripts accept --variant virtualmin as a shortcut for both.

APP_NAME=Rev2Square
APP_ENV=production
# Generate AFTER first build, then paste here (see docs/DEPLOYMENT_VIRTUALMIN_ARM64.md):
#   docker compose -f compose.virtualmin.yaml --env-file /etc/rev2square/.env.virtualmin run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Public HTTPS URL served by Virtualmin Apache (no trailing slash).
APP_URL=https://rev2square.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Container MariaDB (Compose network only, no published port; fully
# isolated from Virtualmin's host MariaDB). The app connects as
# DB_USERNAME; DB_ROOT_PASSWORD is for backups/admin via the db container.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=rev2square
DB_USERNAME=rev2square
DB_PASSWORD=CHANGE-ME-32-BYTES
DB_ROOT_PASSWORD=CHANGE-ME-32-BYTES

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Realtime (Reverb WebSocket server, internal-only container `reverb`).
# Browsers open wss://<APP_URL host>/app/<key>, proxied by Apache (:443)
# to nginx (:8081 loopback) to the reverb container (:8080); the app
# posts events to http://reverb:8080 over the Compose network (TLS
# terminates at Apache, so the internal scheme stays http).
# - REVERB_APP_ID: any stable id (number or short string, e.g. 10001).
# - REVERB_APP_KEY: PUBLIC key (it is baked into frontend assets and sent
#   to every browser as the /app/<key> URL path, by Pusher-protocol
#   design). update_prod.sh passes it as a Docker build-arg automatically.
#   Any unique unguessable string, e.g. openssl rand -hex 16. Rotating it
#   requires a rebuild: always deploy key changes via update_prod.sh
#   (which rebuilds), never by restarting containers alone.
# - REVERB_APP_SECRET: SECRET (server-side event signing). Generate with
#   openssl rand -base64 32. NEVER bake into frontend assets.
# - REVERB_HOST/PORT/SCHEME: internal Compose coordinates. Keep the host
#   `reverb` and port 8080 unless you also edit the nginx /app/ proxy and
#   the reverb healthcheck in compose.virtualmin.yaml.
# - REVERB_ALLOWED_ORIGINS: comma-separated https origins allowed to open
#   sockets (Reverb enforces the browser Origin header). Must match
#   APP_URL; empty/unset keeps the wide-open development default.
REVERB_APP_ID=10001
REVERB_APP_KEY=CHANGE-ME-PUBLIC-KEY
REVERB_APP_SECRET=CHANGE-ME-32-BYTES
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=https://rev2square.example.com
# Do NOT add VITE_* here: this file feeds the container runtime, and
# runtime env cannot reach build-time-baked assets. The only frontend
# value, VITE_REVERB_APP_KEY, is derived from REVERB_APP_KEY at image
# build time (see docker/php/Dockerfile.prod).

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Two proxy layers: Apache (TLS) -> nginx (loopback) -> php-fpm. Laravel's
# direct peer is always the in-Compose nginx, so forwarded headers are
# trusted from private networks only. Keep this unless Docker is
# configured with a non-private subnet (then pin TRUSTED_PROXIES to it).
TRUSTED_PROXIES=PRIVATE_SUBNETS

# Host-header allowlist (comma-separated plain hostnames; loopback entries
# for container healthchecks are always added automatically). Empty means:
# the APP_URL host plus loopback. Pin explicitly if the app must answer to
# additional names (e.g. a staging alias).
# TRUSTED_HOSTS=rev2square.example.com

# Loopback entry point for Apache's ProxyPass. nginx listens on
# 127.0.0.1:APP_LOOPBACK_PORT on the host; change the port only if 8081
# collides with another Virtualmin site (and mirror it in Apache).
APP_LOOPBACK_PORT=8081

# Explicit image target platform. Default linux/arm64 matches the Hetzner
# ARM64 VPS. For local behavior validation on amd64 hardware, override to
# linux/amd64 (this validates wiring, NOT arm64 execution).
DOCKER_PLATFORM=linux/arm64

# Deployment variant (virtualmin|prod). Admin diagnostics and backend
# notes use it to render the exact owner commands for this deployment
# (compose file + env file). Keep in sync with the compose file in use.
DEPLOY_VARIANT=virtualmin

# Image tag suffix (rollback support). Leave commented for :latest, or set
# to the deployed git SHA, e.g. APP_VERSION=6037afb.
# APP_VERSION=

AI_PROVIDER=meta
# Never commit a real key. Paste the server-side key here only.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Optional: raise the GitHub import rate limit (60/hr anonymous).
GITHUB_TOKEN=
# Import budgets (defaults shown). Inventory (what exists) is tracked
# separately from evidence (what enters AI context).
# GITHUB_MAX_FILES=50
# GITHUB_MAX_EVIDENCE_BYTES=500000
# GITHUB_MAX_EXTRACTION_BYTES=100000
# GITHUB_MAX_CHUNK_BYTES=20000
# GITHUB_MAX_DOWNLOAD_BYTES=2000000
# GITHUB_MAX_DOWNLOAD_FILE_BYTES=1000000
# GITHUB_MAX_INVENTORY=5000
# GITHUB_TOKEN_BUDGET=100000
# Analysis evidence budget (chars/4) per AI run.
# AI_ANALYSIS_TOKEN_BUDGET=60000
