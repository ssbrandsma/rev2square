# Rev2Square production Nginx image (WP5B).
#
# Serves the compiled frontend assets baked in at build time (same
# package-lock.json as the app image, built independently so nginx needs no
# shared volume with php-fpm). No source bind mounts at runtime.

FROM node:22 AS assets

WORKDIR /src

COPY package.json package-lock.json ./

RUN npm ci --ignore-scripts --no-audit --no-fund

COPY resources resources
COPY vite.config.js ./
COPY public public

RUN npm run build

FROM nginx:1.28

# curl serves the container healthcheck (the base image ships no HTTP client).
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY docker/nginx/default.prod.conf /etc/nginx/conf.d/default.conf
COPY public /var/www/public
COPY --from=assets /src/public/build /var/www/public/build
