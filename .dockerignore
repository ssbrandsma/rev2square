# Docker build context exclusions. Critical for the WP5B production images:
# no env files (they hold secrets), no local build output, no dev logs or
# caches, no tests. The dev Dockerfile only COPYs the entrypoint script, so
# these exclusions affect production builds only.
.git
node_modules
vendor
.env*
public/build
public/hot
public/storage
storage/*.key
storage/logs/*
storage/app/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
.phpunit.result.cache
.phpunit.cache
backups
tests
