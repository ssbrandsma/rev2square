# Rev2Square isolated filesystem-extraction runner (Linux ARM64).
# Offline extraction only: no mounts, no block/MTD devices, no root.
#
# Pinned:
#   7-Zip ZS v26.02-v1.5.7-R2, linux-gcc-arm64.zip (native ARM64)
#     sha256:64511f6ebc32d5257a535b33b21a5b6712c72aa91e28524f41e1ce92e803c909
#     source: https://github.com/mcmilk/7-Zip-zstd/releases/tag/v26.02-v1.5.7-R2
#     license: LGPL-2.1-or-later (plus BSD Zstd / public-domain LZMA;
#       confirm DOC/License.txt in the release before production use)
#     role: CramFS + SquashFS read/extract, archive fallback
#   squashfs-tools 1:4.5.1-1 (Debian bookworm, APT-signed)
#     license: GPL-2.0-or-later
#     role: unsquashfs second path for vendor SquashFS variants
#   ubi-reader 0.8.16 (PyPI sdist, sha256-verified below)
#     sha256:d6d81b19c3ddd81e21d83a5aa19f9dfa1f6e61bf39d866cea4bd0581b243bd39
#     source: https://pypi.org/project/ubi-reader/0.8.16/
#     (maintained onekey-sec fork of jrspruitt/ubi_reader; LICENSE is
#     GPL-3.0 — the PyPI "Proprietary" classifier is a metadata error)
#     license: GPL-3.0-only
#     role: offline UBI/UBIFS extraction (mtd-utils is deliberately NOT
#       included: its UBI tooling needs MTD devices, which the sandbox
#       never exposes)
#
# sasquatch is deliberately NOT included: unmaintained, conflicting
# forks, and unnecessary next to 7zz + unsquashfs + ubireader.
#
# Build (owner, on the ARM64 server):
#   docker build -f docker/analysis/Dockerfile.extract \
#     -t rev2square/extract:1.0 docker/analysis
ARG DEBIAN_IMAGE=debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
ARG SEVENZZ_URL=https://github.com/mcmilk/7-Zip-zstd/releases/download/v26.02-v1.5.7-R2/linux-gcc-arm64.zip
ARG SEVENZZ_SHA256=64511f6ebc32d5257a535b33b21a5b6712c72aa91e28524f41e1ce92e803c909
ARG UBIREADER_URL=https://files.pythonhosted.org/packages/49/3a/fbad252043b1a67e6ecafc77cf4c7f4068da0572778815b745d3774bea2d/ubi_reader-0.8.16.tar.gz
ARG UBIREADER_SHA256=d6d81b19c3ddd81e21d83a5aa19f9dfa1f6e61bf39d866cea4bd0581b243bd39

FROM ${DEBIAN_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    SEVENZZ_BIN=/opt/7zz/7zz \
    UNSQUASHFS_BIN=/usr/bin/unsquashfs \
    UBIREADER_BIN=/usr/local/bin/ubireader_extract_files \
    TOOL_IMAGE=rev2square/extract:1.0

LABEL org.rev2square.tool="extract" \
      org.rev2square.tool-version="7zz-26.02-v1.5.7-R2+squashfs-4.5.1-1+ubireader-0.8.16" \
      org.rev2square.7zz-sha256="64511f6ebc32d5257a535b33b21a5b6712c72aa91e28524f41e1ce92e803c909" \
      org.rev2square.ubireader-sha256="d6d81b19c3ddd81e21d83a5aa19f9dfa1f6e61bf39d866cea4bd0581b243bd39" \
      org.rev2square.base-image="debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl python3 python3-pip unzip \
        squashfs-tools=1:4.5.1-1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/7zz /opt/runner /provenance

COPY runner.py /opt/runner/runner.py

RUN curl -fsSL -o /tmp/7zz.zip "${SEVENZZ_URL}" \
    && echo "${SEVENZZ_SHA256}  /tmp/7zz.zip" | sha256sum -c - \
    && unzip -q -o /tmp/7zz.zip -d /tmp/7zzdist \
    && rm /tmp/7zz.zip \
    && cp /tmp/7zzdist/7zz /opt/7zz/7zz \
    && rm -rf /tmp/7zzdist \
    && chmod 755 /opt/7zz/7zz \
    && curl -fsSL -o /tmp/ubi-reader.tar.gz "${UBIREADER_URL}" \
    && echo "${UBIREADER_SHA256}  /tmp/ubi-reader.tar.gz" | sha256sum -c - \
    && pip install --no-cache-dir --break-system-packages \
        /tmp/ubi-reader.tar.gz \
    && rm /tmp/ubi-reader.tar.gz \
    && pip freeze > /provenance/python-freeze.txt

# Smoke tests fail the build loudly (incl. 7zz glibc compat and the
# ubireader console script). Fallback if 7zz fails here: build tag
# v26.02-v1.5.7-R2 from source for this glibc (see delivery doc).
RUN /opt/7zz/7zz i > /provenance/7zz-info.txt 2>&1 \
    && unsquashfs 2>&1 | head -3 | grep -qi 'squashfs' \
    && unsquashfs -v > /provenance/unsquashfs-version.txt 2>&1 || true \
    && command -v ubireader_extract_files \
    && ubireader_extract_files --help > /provenance/ubireader-help.txt 2>&1 || true \
    && chmod 644 /provenance/* \
    && chmod 755 /opt/runner/runner.py \
    && python3 /opt/runner/runner.py --dry-run --tool extract \
        --profile 7zz-list --params-json '{}' --workdir /tmp/dry \
        | grep -q '7zz'

USER www-data

CMD ["python3", "/opt/runner/runner.py", "--tool", "extract", \
     "--spool", "/spool", "--results", "/results"]
