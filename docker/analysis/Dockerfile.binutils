# Rev2Square isolated objdump runner (Linux ARM64).
#
# Pinned: Debian bookworm binutils-multiarch 2.40-2 (APT-signed).
# Provides the multiarch objdump whose exact architecture coverage is
# discovered at build time (see /provenance/objdump-architectures.txt)
# and qualified by the owner before new -m mappings route traffic.
# License: GPL-3.0-or-later (GNU binutils).
#
# Build (owner, on the ARM64 server):
#   docker build -f docker/analysis/Dockerfile.binutils \
#     -t rev2square/binutils:2.40-2 docker/analysis
ARG DEBIAN_IMAGE=debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3

FROM ${DEBIAN_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    OBJDUMP_BIN=/usr/bin/objdump \
    OBJDUMP_MACHINES_FILE=/opt/objdump/machines.txt \
    TOOL_IMAGE=rev2square/binutils:2.40-2

LABEL org.rev2square.tool="objdump" \
      org.rev2square.tool-version="2.40-2" \
      org.rev2square.tool-source="Debian bookworm binutils-multiarch=2.40-2 (APT-signed Release)" \
      org.rev2square.tool-license="GPL-3.0-or-later" \
      org.rev2square.base-image="debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3"

# Full python3 (NOT python3-minimal): the runner needs stdlib
# modules such as json that the minimal package omits.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils-multiarch=2.40-2 \
        python3 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/objdump /opt/runner /provenance

COPY runner.py /opt/runner/runner.py

# Verified -m allowlist: exactly the two mappings with checked-in
# integration coverage. Extensions require a verified run first
# (see GhidraAdapter/ObjdumpAdapter VERIFIED maps + owner protocol).
RUN printf 'i386\ni386:x86-64\n' > /opt/objdump/machines.txt \
    && objdump -i > /provenance/objdump-architectures.txt \
    && objdump --version > /provenance/objdump-version.txt \
    && python3 --version > /provenance/python-version.txt \
    && chmod 644 /opt/objdump/machines.txt /provenance/* \
    && chmod 755 /opt/runner/runner.py

# Spool/results mount points (named volumes shared with the coordinator).
# Pre-created www-data-owned so volume initialization preserves uid 33:
# the runner reads the spool (mounted :ro) and writes results as
# www-data. Never 777: these carry untrusted job traffic.
RUN mkdir -p /spool /results && chown www-data:www-data /spool /results

USER www-data

# Runtime self-checks execute as the non-root runtime user: stdlib
# coverage for every runner.py import, tool executability, and the
# dry-run argv path. HOME points at tmpfs (as in production).
RUN export HOME=/tmp \
    && python3 -c "import argparse, fcntl, hashlib, json, os, platform, re, select, shutil, signal, subprocess, sys, time" \
    && objdump -i | grep -q '^  i386$' \
    && mkdir -p /tmp/dry \
    && python3 /opt/runner/runner.py --dry-run --tool objdump \
        --profile auto --params-json '{}' --workdir /tmp/dry \
        | grep -q '"-M", "intel"'

CMD ["python3", "/opt/runner/runner.py", "--tool", "objdump", \
     "--spool", "/spool", "--results", "/results"]
