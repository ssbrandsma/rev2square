# Minimal non-secret framework env for the dev analysis coordinator.
# Mounted over /var/www/.env so the bind-mounted repo .env (which may
# hold real secrets) is NOT visible to the coordinator. Secrets must
# never be added here: DB credentials arrive via the compose
# `environment:` allowlist, and APP_KEY / AI keys are absent on purpose.
APP_ENV=local
APP_DEBUG=false
LOG_CHANNEL=single
LOG_LEVEL=debug
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
SESSION_DRIVER=array
